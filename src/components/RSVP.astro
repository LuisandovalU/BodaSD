---
// src/components/RSVP.astro
const whatsappMX = '525620862829';
const whatsappCO = '573138914271';
---

<section class="rsvp-section">

  {/* Fondo sutil de papel */}
  <div class="rsvp-bg"></div>

  <div class="relative z-10 w-full max-w-5xl mx-auto flex flex-col items-center">
    
    {/* ===== VISTA 1: FORMULARIO ===== */}
    <div id="rsvp-form-view" class="w-full">
      <div class="w-full flex flex-col lg:flex-row lg:items-start lg:justify-center gap-10 lg:gap-16 px-4">
        {/* Izquierda en Desktop: Imagen y subtítulo */}
        <div class="rsvp-header flex-1 flex flex-col items-center lg:items-start lg:mt-10">
          <img 
            src="/confirma.webp" 
            alt="Confirmación de Asistencia" 
            class="rsvp-header-img lg:origin-left" 
          />
          <p class="rsvp-subtitle lg:text-left mt-6">¡Nos encantaría celebrar contigo!</p>
          <p class="font-sans text-[9px] md:text-[10px] tracking-[0.2em] uppercase text-[#c5a059] mt-4 font-semibold text-center lg:text-left [text-wrap:balance]">
            Fecha límite de confirmación:<br/>20 de Agosto
          </p>
        </div>

        {/* Derecha en Desktop: Formulario */}
        <div class="flex-1 w-full max-w-md mx-auto lg:mx-0">
          <div class="rsvp-card">
            <form id="rsvp-form" class="rsvp-form" novalidate>
              {/* Campos Nombre y Apellido */}
              <div class="rsvp-field">
                <label class="rsvp-label">
                  <span class="rsvp-label-num">01</span>
                  Tus Datos
                </label>
                <div class="flex flex-col sm:flex-row gap-4 w-full">
                  <input
                    type="text"
                    id="rsvp-name"
                    name="name"
                    required
                    autocomplete="given-name"
                    placeholder="Nombre(s)"
                    class="rsvp-input w-full"
                  />
                  <input
                    type="text"
                    id="rsvp-lastname"
                    name="lastname"
                    required
                    autocomplete="family-name"
                    placeholder="Apellido(s)"
                    class="rsvp-input w-full"
                  />
                </div>
              </div>

              {/* Campo asistencia */}
              <div class="rsvp-field">
                <span class="rsvp-label">
                  <span class="rsvp-label-num">02</span>
                  ¿Nos acompañarás?
                </span>
                <div class="rsvp-choices">
                  <label class="rsvp-choice" id="choice-yes">
                    <input type="radio" name="attendance" value="yes" required class="rsvp-radio" id="radio-yes" />
                    <span class="rsvp-choice-box">
                      <span class="rsvp-choice-text">¡Sí, ahí estaré!</span>
                    </span>
                  </label>
                  <label class="rsvp-choice" id="choice-no">
                    <input type="radio" name="attendance" value="no" class="rsvp-radio" id="radio-no" />
                    <span class="rsvp-choice-box">
                      <span class="rsvp-choice-text">Con cariño, no podré asistir.</span>
                    </span>
                  </label>
                </div>
              </div>

              {/* Campo canción */}
              <div class="rsvp-field">
                <label for="rsvp-song" class="rsvp-label">
                  <span class="rsvp-label-num">03</span>
                  ¿Qué canción no puede faltar?
                </label>
                <input
                  type="text"
                  id="rsvp-song"
                  name="song"
                  placeholder="Ej. La Gota Fría o Payaso de Rodeo..."
                  class="rsvp-input"
                />
              </div>

              {/* Botón enviar */}
              <button type="submit" class="rsvp-submit" id="btn-rsvp-submit">
                <svg class="rsvp-submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12zm0 0h7.5" />
                </svg>
                Confirmar Asistencia
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    {/* ===== VISTA 2: CONFIRMACIÓN (SÍ ASISTE) ===== */}
    <div id="rsvp-success-yes" class="hidden w-full max-w-2xl mx-auto px-4">
      <div class="confirmation-card confirmation-yes">
        
        {/* Icono corazón */}
        <div class="confirmation-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>

        <h3 class="confirmation-title">¡Qué alegría que nos acompañes!</h3>
        <p class="confirmation-subtitle">Tu asistencia ha quedado registrada.</p>
        
        <div class="confirmation-divider"></div>

        <p class="confirmation-text">
          Para reservar tu lugar, realiza el pago de <strong id="dynamic-amount">$300 MXN</strong> por persona a la cuenta de tu país:<br/>
          <span class="text-xs text-[#c5a059] block mt-2">(Por favor, colocar en concepto: Boda)</span>
        </p>

        {/* Selector de país */}
        <div class="country-tabs">
          <button class="country-tab active" id="tab-mx" data-country="mx">
            <span class="country-flag">🇲🇽</span> México
          </button>
          <button class="country-tab" id="tab-co" data-country="co">
            <span class="country-flag">🇨🇴</span> Colombia
          </button>
        </div>

        {/* Datos México */}
        <div class="payment-details" id="payment-mx">
          <div class="payment-row">
            <span class="payment-label">Titular</span>
            <span class="payment-value">Samuel Montalvo Diaz</span>
          </div>
          <div class="payment-row">
            <span class="payment-label">Institución</span>
            <span class="payment-value">Mercado Pago W</span>
          </div>
          <div class="payment-row">
            <span class="payment-label">CLABE</span>
            <span class="payment-value payment-mono">722969020178881262</span>
          </div>
        </div>

        {/* Datos Colombia */}
        <div class="payment-details hidden" id="payment-co">
          <div class="payment-row">
            <span class="payment-label">Titular</span>
            <span class="payment-value">Manuela González</span>
          </div>
          <div class="payment-row">
            <span class="payment-label">Institución</span>
            <span class="payment-value">Nequi</span>
          </div>
          <div class="payment-row">
            <span class="payment-label">No. de Celular</span>
            <span class="payment-value payment-mono">313 891 4271</span>
          </div>
        </div>

        <p class="confirmation-comprobante">Una vez realizado el pago, envía tu comprobante:</p>

        {/* Botones WhatsApp */}
        <div class="whatsapp-buttons">
          <a id="wa-mx" href={`https://wa.me/${whatsappMX}?text=${encodeURIComponent('¡Hola! Adjunto mi comprobante de pago para confirmar mi lugar en la boda de Sebastián y Daniela 💒')}`} target="_blank" rel="noopener" class="wa-btn wa-btn-mx">
            <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>Enviar a México</span>
          </a>
          <a id="wa-co" href={`https://wa.me/${whatsappCO}?text=${encodeURIComponent('¡Hola! Adjunto mi comprobante de pago para confirmar mi lugar en la boda de Sebastián y Daniela 💒')}`} target="_blank" rel="noopener" class="wa-btn wa-btn-co">
            <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>Enviar a Colombia</span>
          </a>
        </div>
      </div>
    </div>

    {/* ===== VISTA 3: CONFIRMACIÓN (NO ASISTE) ===== */}
    <div id="rsvp-success-no" class="hidden w-full max-w-2xl mx-auto px-4">
      <div class="confirmation-card confirmation-no">
        <div class="confirmation-icon confirmation-icon-sad">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
          </svg>
        </div>
        <h3 class="confirmation-title">Te extrañaremos</h3>
        <p class="confirmation-subtitle">Gracias por hacérnoslo saber. Te deseamos lo mejor y esperamos verte pronto.</p>
      </div>
    </div>

    {/* Galería Moderna Editorial (Slider Automático Infinito) */}
    <div class="relative mt-20 mb-16 lg:mt-32 lg:mb-24 overflow-hidden flex group shrink-0" style="width: 100vw; margin-left: calc(50% - 50vw);">
      <div class="marquee-track flex gap-4 pr-4 shrink-0">
        {[1, 3, 4, 10, 11, 12, 13].map((num) => (
          <div class="shrink-0 w-[65vw] sm:w-[320px] md:w-[400px] aspect-[4/5] relative">
            <img 
              src={`/collage/foto${num}.webp`} 
              alt="Sebastián y Daniela" 
              class="w-full h-full object-cover object-center rounded-sm" 
              loading="lazy" 
            />
          </div>
        ))}
      </div>
      {/* Pista duplicada para el scroll infinito perfecto */}
      <div class="marquee-track flex gap-4 pr-4 shrink-0" aria-hidden="true">
        {[1, 3, 4, 10, 11, 12, 13].map((num) => (
          <div class="shrink-0 w-[65vw] sm:w-[320px] md:w-[400px] aspect-[4/5] relative">
            <img 
              src={`/collage/foto${num}.webp`} 
              alt="Sebastián y Daniela" 
              class="w-full h-full object-cover object-center rounded-sm" 
              loading="lazy" 
            />
          </div>
        ))}
      </div>
    </div>

    {/* Firma final */}
    <div class="rsvp-signature flex flex-col items-center">
      <p class="font-sans italic font-light text-[#6b1424] text-[13px] tracking-[0.25em] mb-1 opacity-90">con amor:</p>
      <img src="/sebasdani_wine.webp" alt="Sebastián & Daniela" class="rsvp-sig-large" />
    </div>

  </div>

</section>

<style>
  .rsvp-section {
    position: relative;
    width: 100%;
    background: #f5f5f0;
    padding: 5rem 1.5rem 6rem;
    overflow: hidden;
  }

  .rsvp-bg {
    position: absolute;
    inset: 0;
    background-image: url('/hoja.webp');
    background-size: cover;
    opacity: 0.07;
    pointer-events: none;
  }

  /* Header */
  .rsvp-header {
    text-align: center;
  }

  .rsvp-header-img {
    width: 90%;
    max-width: 420px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(107,20,36,0.2));
  }

  .rsvp-subtitle {
    font-family: 'Cinzel', serif;
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #4a0d18;
    margin: 0;
  }

  /* Card */
  .rsvp-card {
    width: 100%;
    background: white;
    border: 1px solid rgba(107,20,36,0.08);
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.08), 0 4px 12px rgba(107,20,36,0.06);
    overflow: hidden;
    position: relative;
  }

  .rsvp-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #c5a059, #6b1424, #c5a059);
  }

  .rsvp-form {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 420px;
    margin: 0 auto;
  }

  /* Fields */
  .rsvp-field {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rsvp-label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #6b1424;
  }

  .rsvp-label-num {
    font-family: 'Inter', sans-serif;
    font-size: 0.5rem;
    color: #c5a059;
    opacity: 0.8;
  }

  .rsvp-input {
    width: 100%;
    background: #fafaf8;
    border: 1px solid rgba(107,20,36,0.15);
    border-radius: 2px;
    padding: 0.85rem 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #4a0d18;
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
    box-sizing: border-box;
  }

  .rsvp-input::placeholder {
    color: rgba(107,20,36,0.3);
    font-size: 0.75rem;
  }

  .rsvp-input:focus {
    border-color: #c5a059;
    box-shadow: 0 0 0 3px rgba(197,160,89,0.1);
  }

  /* Radio choices */
  .rsvp-choices {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rsvp-choice {
    cursor: pointer;
    display: block;
  }

  .rsvp-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  .rsvp-choice-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(107,20,36,0.12);
    border-radius: 2px;
    background: #fafaf8;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .rsvp-choice:hover .rsvp-choice-box {
    border-color: rgba(197,160,89,0.5);
    background: rgba(197,160,89,0.04);
  }

  .rsvp-radio:checked + .rsvp-choice-box {
    border-color: #c5a059;
    background: rgba(197,160,89,0.08);
    box-shadow: 0 0 0 3px rgba(197,160,89,0.1);
  }

  .rsvp-choice-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: #4a0d18;
    letter-spacing: 0.05em;
  }

  /* Submit */
  .rsvp-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    background: #6b1424;
    color: #faf8f5;
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    padding: 1.1rem 2rem;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(107,20,36,0.3);
  }

  .rsvp-submit:hover {
    background: #4a0d18;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(107,20,36,0.4);
  }

  .rsvp-submit:active { transform: translateY(0); }

  .rsvp-submit-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  /* ===== CONFIRMATION CARDS ===== */
  .confirmation-card {
    background: white;
    border: 1px solid rgba(107,20,36,0.08);
    border-radius: 8px;
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0,0,0,0.08), 0 4px 16px rgba(107,20,36,0.06);
    position: relative;
    overflow: hidden;
    animation: slideUp 0.6s ease-out;
  }

  .confirmation-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, #c5a059, #6b1424, #c5a059);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .confirmation-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6b1424, #8a1a30);
    color: #faf8f5;
    margin-bottom: 1.5rem;
    animation: pulse-heart 2s ease-in-out infinite;
  }

  .confirmation-icon-sad {
    background: linear-gradient(135deg, #8a7a6d, #6b6560);
  }

  @keyframes pulse-heart {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  .confirmation-title {
    font-family: 'Cinzel', serif;
    font-size: 1.3rem;
    letter-spacing: 0.15em;
    color: #4a0d18;
    margin-bottom: 0.5rem;
  }

  .confirmation-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: #6b6560;
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .confirmation-divider {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #c5a059, transparent);
    margin: 1.5rem auto;
  }

  .confirmation-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #4a0d18;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .confirmation-text strong {
    color: #6b1424;
    font-weight: 700;
  }

  /* Country Tabs */
  .country-tabs {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .country-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    border: 1px solid rgba(107,20,36,0.15);
    border-radius: 50px;
    background: transparent;
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #4a0d18;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .country-tab:hover {
    border-color: #c5a059;
    background: rgba(197,160,89,0.06);
  }

  .country-tab.active {
    background: #6b1424;
    color: #faf8f5;
    border-color: #6b1424;
  }

  .country-flag {
    font-size: 1rem;
  }

  /* Payment Details */
  .payment-details {
    background: #faf8f5;
    border: 1px solid rgba(197,160,89,0.2);
    border-radius: 6px;
    padding: 1.2rem 1.5rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .payment-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(197,160,89,0.1);
  }

  .payment-row:last-child {
    border-bottom: none;
  }

  .payment-label {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a7a6d;
  }

  .payment-value {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #4a0d18;
    font-weight: 500;
    text-align: right;
  }

  .payment-mono {
    font-family: 'JetBrains Mono', 'SF Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .confirmation-comprobante {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: #6b6560;
    margin-bottom: 1rem;
  }

  /* WhatsApp Buttons */
  .whatsapp-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 480px) {
    .whatsapp-buttons {
      flex-direction: row;
      justify-content: center;
    }
  }

  .wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    letter-spacing: 0.03em;
  }

  .wa-btn-mx {
    background: #25D366;
    color: white;
  }

  .wa-btn-co {
    background: #25D366;
    color: white;
  }

  .wa-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37,211,102,0.35);
  }

  .wa-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* Signature */
  .rsvp-signature {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 30;
    pointer-events: none;
  }

  .rsvp-sig-large {
    width: 80%;
    max-width: 220px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(107,20,36,0.15));
    animation: respiration 5s ease-in-out infinite;
  }

  @keyframes respiration {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
  }

  /* Utility */
  .hidden {
    display: none !important;
  }
</style>

<script>
  import { db } from '../firebase/client';
  import { collection, query, where, getDocs, addDoc, updateDoc, doc } from 'firebase/firestore';

  document.addEventListener('DOMContentLoaded', () => {
    const rsvpBtn = document.getElementById('btn-rsvp');
    const formView = document.getElementById('rsvp-form-view');
    const successYes = document.getElementById('rsvp-success-yes');
    const successNo = document.getElementById('rsvp-success-no');
    const form = document.getElementById('rsvp-form');

    // Manejo de tabs de bancos
    const tabMX = document.getElementById('tab-mx');
    const tabCO = document.getElementById('tab-co');
    const paymentMX = document.getElementById('payment-mx');
    const paymentCO = document.getElementById('payment-co');

    tabMX?.addEventListener('click', () => {
      tabMX.classList.add('active');
      tabCO?.classList.remove('active');
      paymentMX?.classList.remove('hidden');
      paymentCO?.classList.add('hidden');
      const amount = document.getElementById('dynamic-amount');
      if (amount) amount.textContent = '$300 MXN';
    });

    tabCO?.addEventListener('click', () => {
      tabCO.classList.add('active');
      tabMX?.classList.remove('active');
      paymentCO?.classList.remove('hidden');
      paymentMX?.classList.add('hidden');
      const amount = document.getElementById('dynamic-amount');
      if (amount) amount.textContent = '$60,000 COP';
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('rsvp-name') as HTMLInputElement;
      const lastNameInput = document.getElementById('rsvp-lastname') as HTMLInputElement;
      const attendanceInput = document.querySelector('input[name="attendance"]:checked') as HTMLInputElement;

      if (!nameInput?.value.trim()) {
        nameInput?.focus();
        if (nameInput) nameInput.style.borderColor = '#c5a059';
        return;
      }
      
      if (!lastNameInput?.value.trim()) {
        lastNameInput?.focus();
        if (lastNameInput) lastNameInput.style.borderColor = '#c5a059';
        return;
      }

      if (!attendanceInput) {
        const choices = document.querySelector('.rsvp-choices');
        choices?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const name = nameInput.value.trim();
      const lastName = lastNameInput.value.trim();
      const fullName = `${name} ${lastName}`;
      const going = attendanceInput.value === 'yes';
      const songInput = document.getElementById('rsvp-song') as HTMLInputElement;
      const song = songInput ? songInput.value.trim() : '';
      
      // Determinar país según el tab activo
      const pais = tabMX?.classList.contains('active') ? 'MX' : 'CO';

      try {
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalBtnText = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Enviando...';
        }

        const normalizedName = name.toLowerCase();
        const normalizedLastName = lastName.toLowerCase();
        
        const guestsRef = collection(db, 'invitados');
        const q = query(guestsRef, where('nombreNormalizado', '==', normalizedName), where('apellidoNormalizado', '==', normalizedLastName));
        const querySnapshot = await getDocs(q);

        if (!querySnapshot.empty) {
          const guestDoc = querySnapshot.docs[0];
          await updateDoc(doc(db, 'invitados', guestDoc.id), {
            asiste: going,
            cancion: song || '—',
            pais: pais,
            fechaActualizacion: new Date().toISOString()
          });
        } else {
          await addDoc(guestsRef, {
            nombre: name,
            apellido: lastName,
            nombreNormalizado: normalizedName,
            apellidoNormalizado: normalizedLastName,
            nombreCompleto: fullName,
            asiste: going,
            cancion: song || '—',
            pais: pais,
            fechaRegistro: new Date().toISOString()
          });
        }

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;
        }

        // Ocultar formulario con fade
        if (formView) {
          formView.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          formView.style.opacity = '0';
          formView.style.transform = 'translateY(-20px)';
        }

        setTimeout(() => {
          formView?.classList.add('hidden');
          
          if (going) {
            successYes?.classList.remove('hidden');
            successYes?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            successNo?.classList.remove('hidden');
            successNo?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }, 450);
      } catch (error) {
        console.error("Error saving to Firebase:", error);
        alert("Hubo un error al enviar tu confirmación. Por favor intenta de nuevo.");
      }
    });
  });
</script>
