---
// src/components/HowToArrive.astro

const mapsUrl = "https://maps.google.com/?q=Hacienda+San+Pablo+Subachoque+Colombia";
---

<section class="w-full relative py-24 md:py-32 px-4 overflow-hidden bg-[#faf8f5]">
  
  {/* Textura de papel premium de fondo para toda la sección */}
  <div class="absolute inset-0 z-0">
    <img src="/hoja.webp" alt="Textura de Hoja" class="w-full h-full object-cover opacity-60" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-tr from-[#faf8f5]/80 via-[#faf8f5]/40 to-[#faf8f5]/80 pointer-events-none"></div> 
  </div>

  <div class="relative z-10 max-w-2xl mx-auto flex flex-col items-center text-center">

    {/* Título */}
    <p class="font-sans text-[9px] md:text-[10px] tracking-[0.4em] uppercase text-[#c5a059] mb-3">
      El Lugar
    </p>
    <h2 class="font-script text-[3.5rem] md:text-[4.5rem] text-brand-wine leading-none mb-8 drop-shadow-sm">
      Cómo llegar
    </h2>
    
    <div class="flex items-center gap-3 justify-center mb-16">
      <span class="w-12 h-[1px] bg-[#c5a059]/40"></span>
      <span class="text-[#c5a059] text-[8px]">◆</span>
      <span class="w-12 h-[1px] bg-[#c5a059]/40"></span>
    </div>

    {/* Detalles de la Dirección */}
    <h3 class="font-serif text-xl md:text-2xl font-bold tracking-[0.2em] uppercase text-brand-wine mb-2">
      Hacienda San Pablo
    </h3>
    <p class="font-sans text-[10px] md:text-[11px] tracking-[0.3em] uppercase text-[#c5a059] mb-12">
      Subachoque · Colombia
    </p>


    {/* Botón Google Maps Minimalista */}
    <a 
      href={mapsUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 px-10 py-4 border border-[#c5a059] text-brand-wine hover:bg-[#c5a059] hover:text-[#faf8f5] transition-all duration-300 group"
    >
      <svg class="w-4 h-4 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
      </svg>
      <span class="font-serif text-[9px] md:text-[10px] tracking-[0.3em] uppercase font-bold">Ver en Mapa</span>
    </a>

  </div>
</section>
