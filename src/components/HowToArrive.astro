---
// src/components/HowToArrive.astro

// Google Maps link to Hacienda San Pablo, Subachoque, Colombia
const mapsUrl = "https://maps.google.com/?q=Hacienda+San+Pablo+Subachoque+Colombia";
const mapsEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3975.1234567890!2d-74.1830!3d4.9313!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e3f8f9f9f9f9f9f%3A0x1234567890abcdef!2sHacienda%20San%20Pablo%2C%20Subachoque!5e0!3m2!1ses!2sco!4v1234567890";
---

<section class="how-to-arrive-section">
  
  {/* Fondo decorativo */}
  <div class="arrive-bg">
    <div class="arrive-bg-overlay"></div>
  </div>

  <div class="arrive-container">

    {/* Título */}
    <div class="arrive-title-block">
      <p class="arrive-eyebrow">El Lugar</p>
      <h2 class="arrive-title">Cómo Llegar</h2>
      <div class="arrive-divider">
        <span class="arrive-divider-line"></span>
        <span class="arrive-divider-diamond">◆</span>
        <span class="arrive-divider-line"></span>
      </div>
    </div>

    {/* Tarjeta de dirección */}
    {/* Tarjeta de dirección Editorial */}
    <div class="w-full max-w-[320px] md:max-w-[380px] px-6 py-12 md:px-10 md:py-14 text-center border-[0.5px] border-[#c5a059]/50 relative rounded-sm overflow-hidden bg-[#faf8f5] shadow-xl">
      {/* Textura de papel premium de fondo */}
      <div class="absolute inset-0 z-0 bg-[#faf8f5]">
        <img src="/hoja.webp" alt="Textura de Hoja" class="w-full h-full object-cover opacity-85" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-tr from-[#faf8f5]/60 via-[#faf8f5]/20 to-[#faf8f5]/70 pointer-events-none"></div> 
      </div>

      <div class="relative z-10 flex flex-col items-center">
        <h3 class="font-serif text-lg md:text-xl font-semibold tracking-[0.15em] uppercase text-[#4a0d18] mb-1">
          Hacienda San Pablo
        </h3>
        <p class="font-sans text-[8px] md:text-[9px] tracking-[0.35em] uppercase text-[#c5a059] mb-8">
          Subachoque · Colombia
        </p>

        <div class="flex flex-col items-center gap-1.5 mb-10">
          <p class="font-sans text-[8px] md:text-[9px] tracking-[0.2em] uppercase text-[#4a0d18]/80">
            Viernes, 11 de Diciembre de 2026
          </p>
          <p class="font-sans text-[8px] md:text-[9px] tracking-[0.2em] uppercase text-[#4a0d18]/80">
            3:00 PM
          </p>
        </div>

        {/* Botón Google Maps Minimalista */}
        <a 
          href={mapsUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-8 py-3 border-[0.5px] border-[#c5a059] text-[#4a0d18] hover:bg-[#c5a059] hover:text-[#faf8f5] transition-all duration-300"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          <span class="font-serif text-[8px] md:text-[9px] tracking-[0.25em] uppercase font-semibold">Ver en Mapa</span>
        </a>
      </div>
    </div>

  </div>

</section>

<style>
  .how-to-arrive-section {
    width: 100%;
    position: relative;
    padding: 8rem 1.5rem;
    overflow: hidden;
    background: #1a0508;
  }

  .arrive-bg {
    position: absolute;
    inset: 0;
    background-color: #750b1c; /* Color vino plano elegante */
    z-index: 0;
  }

  .arrive-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.55) 100%);
  }

  .arrive-container {
    position: relative;
    z-index: 10;
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .arrive-title-block {
    text-align: center;
  }

  .arrive-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #c5a059;
    margin-bottom: 0.5rem;
  }

  .arrive-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.4rem, 5vw, 2rem);
    font-weight: 500;
    color: #faf8f5;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
  }

  .arrive-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .arrive-divider-line {
    display: block;
    width: 40px;
    height: 1px;
    background: rgba(197,160,89,0.4);
  }

  .arrive-divider-diamond {
    font-size: 0.4rem;
    color: #c5a059;
    opacity: 0.7;
  }

  /* Se eliminaron estilos innecesarios de la versión oscura anterior */
</style>
