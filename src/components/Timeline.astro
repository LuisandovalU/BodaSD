---
import TimelineItem from './TimelineItem';

const events = [
  { title: 'First Moments', time: '3:00 PM', iconUrl: '/1-recepcion.webp' },
  { title: 'The Vows', time: '3:30 PM', iconUrl: '/2-ceremonia.webp' },
  { title: 'Love & Laughter', time: '4:15 PM', iconUrl: '/2-love.webp', scaleClass: 'scale-125' },
  { title: 'Dinner', time: '5:00 PM', iconUrl: '/3-comida.webp' },
  { title: 'The Evening', time: '6:00 PM', iconUrl: '/6-evening.webp', scaleClass: 'scale-[1.35]' },
  { title: 'Celebration', time: '6:30 PM', iconUrl: '/5-party.webp' },
  { title: 'Forever Begins', time: '9:30 PM', iconUrl: '/7-forever.webp', scaleClass: 'scale-125' },
];
---

<section class="w-full relative py-32 md:py-40 px-4 overflow-hidden bg-brand-wine">
  {/* Fondo plano */}
  <div class="absolute inset-0 z-0 bg-brand-wine"></div>
  
  {/* Gradiente sutil sobre toda la sección */}
  <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/30 pointer-events-none z-0"></div>

  {/* CONTENEDOR PRINCIPAL FLEX/GRID PARA DESKTOP */}
  <div class="relative z-10 w-full max-w-6xl mx-auto flex flex-col lg:flex-row items-center lg:items-start lg:justify-center gap-8 lg:gap-16 pt-10 px-4">
    
    {/* COLUMNA IZQUIERDA: Bienvenida ("Con todo nuestro cariño") */}
    <div class="w-full lg:w-1/2 flex justify-center pb-8 lg:pb-0 lg:sticky lg:top-24 lg:-mt-8">
      {/* Contenedor de entrada (revelado al hacer scroll) */}
      <div id="welcome-card-reveal" class="w-[90%] max-w-[340px] md:max-w-[400px] lg:max-w-[460px] opacity-0 translate-y-12 transition-all duration-1000 ease-out">
        
        {/* Contenedor de la tarjeta (con sombra fuerte y efecto flotante continuo) */}
        <div class="w-full h-full p-8 md:p-12 text-center relative bg-[#faf8f5] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.6)] animate-float">
          
          {/* Textura de papel premium de fondo */}
          <div class="absolute inset-0 z-0 bg-[#faf8f5]">
            <img src="/hoja.webp" alt="Textura de Hoja" class="w-full h-full object-cover opacity-85" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-tr from-[#faf8f5]/60 via-[#faf8f5]/20 to-[#faf8f5]/70 pointer-events-none"></div> 
          </div>

          {/* Doble borde dorado estilo invitación clásica */}
          <div class="absolute inset-3 border-[0.5px] border-[#c5a059]/40 z-10 pointer-events-none"></div>
          <div class="absolute inset-[15px] border-[0.5px] border-[#c5a059]/20 z-10 pointer-events-none"></div>

          <div class="relative z-20 flex flex-col items-center">
            {/* Adorno superior (Estrella/Diamante) */}
            <svg class="w-5 h-5 text-[#c5a059] mb-5 opacity-80" viewBox="0 0 24 24" fill="currentColor">
               <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
            </svg>

            <h3 class="font-serif text-lg md:text-xl tracking-[0.3em] text-[#5e0a16] uppercase font-bold mb-5 leading-relaxed">
              Bienvenido/a
            </h3>
            
            {/* Línea divisoria */}
            <div class="w-16 h-[1px] bg-gradient-to-r from-transparent via-[#c5a059] to-transparent mb-6 opacity-60"></div>

            <p class="font-sans text-[9px] md:text-[10px] leading-[2.8] tracking-[0.2em] uppercase text-[#5e0a16]/90 px-2">
              Al comienzo de nuestro<br/>para siempre y la mejor parte<br/>de esta historia es<br/>celebrarla contigo.
            </p>
          </div> {/* Fin relative z-20 */}
          
        </div> {/* Fin Contenedor de la tarjeta (animate-float) */}
      </div> {/* Fin welcome-card-reveal */}
    </div> {/* Fin COLUMNA IZQUIERDA */}

    {/* COLUMNA DERECHA: Línea de Tiempo */}
    <div class="w-full lg:w-1/2 max-w-lg lg:max-w-none mx-auto lg:mx-0 relative pt-12 lg:pt-0 pb-16">
      {/* Decorative Background Elements */}
      <div class="absolute inset-0 opacity-10 z-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

      <div class="text-center mb-16 relative z-10 flex flex-col items-center">
        <div class="w-[85%] max-w-[280px] md:max-w-[360px] h-auto flex justify-center mb-5">
          <img 
            src="/itinerario.webp" 
            alt="The Evening" 
            class="w-full h-auto object-contain"
            loading="lazy"
          />
        </div>
        <p class="font-sans text-[10px] md:text-xs tracking-[0.25em] leading-loose text-white/90 uppercase max-w-md mx-auto px-4 lg:px-0">
          Cada momento de este día ha sido pensado con amor para celebrar juntos
        </p>
      </div>

      {/* Timeline events container, padded left to align items and center the line */}
      <div class="relative max-w-md mx-auto z-10 pl-8 md:pl-12">
        {/* Vertical Line aligned perfectly with the TimelineItem dots */}
        <div class="absolute left-8 md:left-12 top-0 bottom-0 w-px bg-gradient-to-b from-white/10 via-white/40 to-white/10"></div>
        
        <div class="py-10">
          {events.map((event, index) => (
            <TimelineItem 
              client:visible 
              title={event.title} 
              time={event.time} 
              iconUrl={event.iconUrl} 
              index={index}
              scaleClass={event.scaleClass}
            />
          ))}
        </div>
      </div>
    </div> {/* Fin COLUMNA DERECHA */}

  </div> {/* Fin CONTENEDOR PRINCIPAL */}
</section>

<script>
  // Animación suave ligada al scroll con retención permanente para la línea de tiempo
  document.addEventListener('DOMContentLoaded', () => {
    const timelineElements = document.querySelectorAll('[data-scroll-timeline]');
    
    const updateTimelineScroll = () => {
      const windowHeight = window.innerHeight;
      
      timelineElements.forEach((element) => {
        const el = element as HTMLElement;
        // Si ya fue revelado al 100%, lo mantenemos fijo y evitamos recalcular
        if (el.dataset.revealed === 'true') return;
        
        const rect = el.getBoundingClientRect();
        const elementTop = rect.top;
        
        // Empieza a revelarse cuando entra por abajo
        const startPoint = windowHeight; 
        // Se revela por completo cuando entra un 12% a la pantalla
        const endPoint = windowHeight * 0.88; 
        
        let progress = (startPoint - elementTop) / (startPoint - endPoint);
        progress = Math.max(0, Math.min(1, progress));
        
        const blurAmount = (1 - progress) * 8; // De 8px de desenfoque a 0px
        const xOffset = (1 - progress) * -25; // Se desliza 25px desde la izquierda a 0px
        
        el.style.opacity = progress.toFixed(2);
        el.style.transform = `translateX(${xOffset}px)`;
        el.style.filter = `blur(${blurAmount}px)`;
        
        // Bloquear al 100% de revelado para que se mantenga fijo permanentemente
        if (progress >= 1.0) {
          el.dataset.revealed = 'true';
          el.style.opacity = '1';
          el.style.transform = 'translateX(0)';
          el.style.filter = 'blur(0px)';
        }
      });
    };

    // Intersection Observer para la tarjeta de Bienvenida
    const welcomeCard = document.getElementById('welcome-card-reveal');
    if (welcomeCard) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            welcomeCard.classList.remove('opacity-0', 'translate-y-12');
            welcomeCard.classList.add('opacity-100', 'translate-y-0');
            observer.unobserve(welcomeCard);
          }
        });
      }, { threshold: 0.2 });
      observer.observe(welcomeCard);
    }

    window.addEventListener('scroll', updateTimelineScroll, { passive: true });
    window.addEventListener('resize', updateTimelineScroll, { passive: true });
    updateTimelineScroll();
  });
</script>
