---
import { Image } from 'astro:assets';

// Cuando subas tus imágenes a src/assets, puedes importarlas así:
// import envelopeBg from '../assets/envelope-bg.jpg';
// import flowerImg from '../assets/flower.png';
// import fotoNovios from '../assets/foto-novios.jpg';
---

<section class="flex flex-col w-full bg-[#671104] overflow-hidden">
  
  <div class="relative w-full flex flex-col lg:flex-row items-stretch lg:min-h-screen">
    
    {/* PARTE 1: Fondo verde con el sobre (hero.webp) */}
    <div class="w-full lg:w-1/2 h-[60vh] md:h-[70vh] lg:h-auto relative overflow-hidden bg-[#3a4f3b]">
      <img src="/hero.webp" alt="Fondo Verde Sobre" class="absolute inset-0 w-full h-full object-cover object-bottom opacity-100 animate-slow-zoom origin-center" onerror="this.style.display='none'" loading="eager" fetchpriority="high" />
      {/* Gradiente oscuro sutil para darle profundidad */}
      <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/40 mix-blend-overlay"></div>
    </div>

    {/* PARTE 2: Flor y Detalles de Fecha/Lugar */}
    <div class="w-full lg:w-1/2 h-[65vh] md:h-[75vh] lg:h-auto relative flex flex-col items-center justify-end bg-[#671104]">
      {/* Imagen de la Flor */}
      <div class="absolute inset-0 z-0">
        <img src="/flor.webp" alt="Flor" class="w-full h-full object-cover" onerror="this.style.display='none'" loading="eager" />
      </div>

      {/* Texto Detalles superpuesto en la flor */}
      <div class="relative z-10 text-center space-y-4 md:space-y-6 text-[#faf8f5] w-full px-4 pb-12 md:pb-20">
        <p class="font-serif tracking-[0.4em] text-sm md:text-base uppercase" data-scroll-fade>Viernes 11</p>
        
        {/* HORA ACTUALIZADA A LAS 3 PM */}
        <p class="font-sans tracking-[0.2em] text-sm font-light" data-scroll-fade>3 : 0 0 P M</p>
        
        <p class="font-serif tracking-[0.3em] text-xs md:text-sm uppercase leading-loose" data-scroll-fade>
          Hacienda San Pablo<br/>
          <span class="text-[10px] md:text-xs tracking-[0.4em]">Subachoque . Colombia</span>
        </p>

        {/* NUEVO VERSÍCULO */}
        <div class="mt-6 md:mt-8 px-2 w-full max-w-[95%] md:max-w-lg mx-auto" data-scroll-fade>
          <p class="font-serif italic text-xs md:text-sm leading-relaxed tracking-wide">
            “Y sobre todo, ámense unos a otros,<br />porque el amor es el mejor lazo de unión.”
          </p>
          <p class="font-sans tracking-[0.2em] text-[10px] mt-2 uppercase font-light">
            Colosenses 3:14
          </p>
        </div>
      </div>
    </div>

    {/* PARTE 3: Tarjeta Blanca ("Save our Date") - Flotando entre ambas secciones */}
    <div class="absolute top-[18vh] md:top-[22vh] lg:top-0 lg:inset-0 left-0 w-full flex lg:items-center justify-center z-10 hidden opacity-0 translate-y-32 scale-90 transition-all duration-[1200ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] pointer-events-none" id="hero-card-wrapper">
      <div class="pointer-events-auto w-[85%] max-w-sm lg:max-w-md xl:max-w-lg aspect-[3/4] p-10 lg:p-14 flex flex-col items-center justify-between border-[0.5px] border-[#c5a059]/50 rounded-sm overflow-hidden bg-[#faf8f5] animate-float shadow-luxury">
        {/* Textura de la tarjeta */}
        <div class="absolute inset-0 z-0 bg-[#faf8f5]">
           <img src="/sobre.webp" alt="Textura Tarjeta" class="w-full h-full object-cover opacity-80" onerror="this.style.display='none'" loading="eager" fetchpriority="high" />
           <div class="absolute inset-0 bg-gradient-to-tr from-[#faf8f5]/80 via-[#faf8f5]/40 to-[#faf8f5]/90"></div> 
        </div>

        <div class="relative z-10 flex flex-col items-center h-full justify-between w-full">
          <p class="font-serif tracking-[0.4em] text-[#5e0a16] text-sm mt-4 font-semibold animate-fade-up delay-100">S & D</p>
          
          <div class="text-center flex flex-col items-center justify-center w-full my-4 animate-fade-up delay-300">
            <img 
              src="/save-our-date.webp" 
              alt="Save our Date" 
              class="w-full max-w-[200px] md:max-w-[260px] lg:max-w-[320px] h-auto object-contain" 
              onerror="this.style.display='none'"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <p class="font-serif tracking-[0.4em] text-[#5e0a16] text-sm mb-4 font-semibold animate-fade-up delay-700">
            11 . 12 . 26
          </p>
        </div>
      </div>
    </div>

  </div>

  {/* PARTE 3: Foto de los Novios */}
  <div class="w-full h-[60vh] md:h-[80vh] lg:h-[90vh] relative bg-black">
    <img 
      src="/fotonovios1.webp" 
      alt="Sebastián y Daniela" 
      class="w-full h-full object-cover object-[center_30%] opacity-90"
      loading="eager"
      fetchpriority="high"
    />
    
    {/* Transición sólida superior (onda cayendo con el color exacto de la flor) */}
    <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-10 pointer-events-none -mt-[1px] lg:hidden">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-[30px] md:h-[50px]">
        {/* El color ahora es #671104, que coincide 100% con el fondo superior */}
        <path d="M0,0 C300,100 900,100 1200,0 L1200,0 L0,0 Z" fill="#671104"></path>
      </svg>
    </div>

    {/* Transición sólida inferior (arco blanco subiendo) */}
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-10 pointer-events-none -mb-[1px]">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-[40px] md:h-[70px]">
        <path d="M0,120 C300,0 900,0 1200,120 Z" fill="#faf8f5"></path>
      </svg>
    </div>
    
    {/* Nombres sobre la foto */}
    <div class="absolute bottom-16 md:bottom-24 lg:bottom-32 left-0 w-full flex justify-center z-20 px-4 pointer-events-none">
      <div class="w-[85%] max-w-[350px] md:max-w-[450px] lg:max-w-[550px] flex justify-center">
         <img 
            src="/sebasdani.webp" 
            alt="Sebastián y Daniela" 
            class="w-full h-auto object-contain"
            loading="eager"
            data-scroll-fade
         />
      </div>
    </div>
  </div>


</section>



<script>
  // Animación puramente ligada al Scroll (Parallax Fade)
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('[data-scroll-fade]');
    
    const updateScrollAnimations = () => {
      const windowHeight = window.innerHeight;
      
      animatedElements.forEach(el => {
        const rect = el.getBoundingClientRect();
        const elementTop = rect.top;
        
        const startPoint = windowHeight; 
        const endPoint = windowHeight * 0.90; 
        
        let progress = (startPoint - elementTop) / (startPoint - endPoint);
        progress = Math.max(0, Math.min(1, progress));
        
        const blurAmount = (1 - progress) * 12;
        const yOffset = (1 - progress) * 30;
        
        el.style.opacity = progress.toFixed(2);
        el.style.transform = `translateY(${yOffset}px)`;
        el.style.filter = `blur(${blurAmount}px)`;
      });
    };

    window.addEventListener('scroll', updateScrollAnimations, { passive: true });
    window.addEventListener('resize', updateScrollAnimations, { passive: true });
    updateScrollAnimations();
  });
</script>
