---
import ColorPalette from './ColorPalette';

const ladiesColors = [
  { hex: '#7b8466', name: 'Verde Oliva' },
  { hex: '#c8969b', name: 'Rosa Empolvado' },
  { hex: '#c07a68', name: 'Terracota Suave' },
  { hex: '#8b7365', name: 'Café Moka' },
  { hex: '#f2e176', name: 'Amarillo Pastel' }
];
const gentsColors = [
  { hex: '#27344b', name: 'Azul Marino' },
  { hex: '#59718d', name: 'Azul Medio' },
  { hex: '#757476', name: 'Gris' },
  { hex: '#4e3a31', name: 'Café Moka' }
];
const bannedColors = [
  { hex: '#000000', name: 'Negro (Para el novio)' },
  { hex: '#800020', name: 'Borgoña (Para las damas)' },
  { hex: '#FFFFFF', name: 'Blanco/Marfil (Para la novia)' }
];
---

<section class="w-full flex flex-col bg-[#e9e9e6] relative overflow-hidden">
  
  {/* FONDO GLOBAL DE LA SECCION (Hombres y No Permitidos) para que sea continuo */}
  <div class="absolute inset-0 z-0">
    <img src="/dcabajo.webp" alt="Fondo Base" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  {/* Dress Code Title Image (Flota siempre sobre los fondos) */}
  <div class="absolute top-0 left-0 w-full z-30 flex justify-center pt-16 lg:pt-16 pointer-events-none">
    <img src="/dc.webp" alt="Dress Code" class="w-[85%] max-w-[320px] md:max-w-[400px] lg:max-w-[450px] h-auto object-contain drop-shadow-xl" />
  </div>

  {/* MAIN CONTENT (Split on desktop) */}
  <div class="flex flex-col lg:flex-row w-full relative z-10">
    
    {/* LEFT SECTION: Ladies */}
    <div class="relative w-full lg:w-1/2 flex flex-col items-center pt-48 pb-16 lg:pt-48 lg:pb-16 px-6 text-center border-b lg:border-b-0 lg:border-r border-white/20">
      {/* Background Ladies */}
      <div class="absolute inset-0 z-0">
        <img src="/dcarriba.webp" alt="Fondo Mujeres" class="w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-black/30"></div>
      </div>

      <div class="relative z-10 w-full max-w-md mx-auto flex flex-col items-center">
        <h3 class="font-serif tracking-[0.2em] text-white text-lg md:text-xl uppercase font-bold mb-6">Para Mujeres</h3>
        <p class="font-serif text-[10px] md:text-xs leading-loose tracking-[0.25em] uppercase text-white/95 max-w-md mx-auto">
          Vestidos elegantes son bienvenidos. Explora la siguiente paleta de colores para inspirar tu estilo.
        </p>

        {/* Color Palette Ladies */}
        <div class="pt-10 w-full">
          <ColorPalette client:visible colors={ladiesColors} title="Colores Sugeridos" />
        </div>
      </div>
    </div>

    {/* DIVIDER: Line + Circle (Only on mobile) */}
    <div class="relative w-full h-px z-20 flex lg:hidden justify-center items-center">
      <div class="absolute w-full h-[1px] bg-white/20"></div>
      <div class="w-16 h-16 bg-[#f0f0f0] rounded-full z-10 relative flex items-center justify-center"></div>
    </div>

    {/* RIGHT SECTION: Gentlemen (Transparente, usa el fondo global) */}
    <div class="relative w-full lg:w-1/2 flex flex-col items-center py-16 px-6 text-center">
      <div class="relative z-10 w-full max-w-md mx-auto flex flex-col items-center">
        <h3 class="font-serif tracking-[0.2em] text-white text-lg md:text-xl uppercase font-bold mb-6">Para Hombres</h3>
        <p class="font-serif text-[10px] md:text-xs leading-loose tracking-[0.25em] uppercase text-white/95 max-w-md mx-auto">
          Trajes elegantes son bienvenidos. Explora la siguiente paleta de colores para inspirar tu estilo.
        </p>

        {/* Color Palette Gents */}
        <div class="pt-10 w-full">
          <ColorPalette client:visible colors={gentsColors} title="Colores Sugeridos" />
        </div>
      </div>
    </div>

  </div>

  {/* BOTTOM SECTION: Banned Colors (Transparente, usa el fondo global) */}
  <div class="relative w-full flex flex-col items-center py-16 lg:py-20 px-6 text-center z-10">
    <div class="relative z-10 w-full max-w-4xl mx-auto flex flex-col items-center">
      {/* Banned Colors */}
      <ColorPalette client:visible colors={bannedColors} title="No Permitidos" isBanned={true} />
    </div>
  </div>

</section>
