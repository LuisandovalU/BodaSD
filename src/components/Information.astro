---
import Gifts from './Gifts.astro';
---

<div class="flex flex-col w-full">
  
  {/* Sección Regalos (Animación al scrollear) */}
  <Gifts />

  {/* Separador elegante */}
  <div class="w-full flex justify-center items-center py-4 md:py-8 bg-brand-wine relative z-10">
    <div class="w-20 md:w-32 h-[1px] bg-gradient-to-r from-transparent to-[#c5a059] opacity-70"></div>
    <div class="w-1.5 h-1.5 md:w-2 md:h-2 mx-4 rotate-45 bg-[#c5a059] opacity-70"></div>
    <div class="w-20 md:w-32 h-[1px] bg-gradient-to-l from-transparent to-[#c5a059] opacity-70"></div>
  </div>

  {/* Sección Importante */}
  <section class="text-white pb-32 md:pb-40 pt-16 md:pt-20 px-4 text-center relative overflow-hidden bg-brand-wine">
    
    <div class="max-w-3xl mx-auto relative z-10">
      <div class="space-y-6">
        <div class="flex justify-center mb-6">
          <img src="/importante_gold.webp" alt="Importante" class="w-[90%] max-w-[320px] md:max-w-[400px] h-auto object-contain drop-shadow-sm" />
        </div>
        <p class="font-sans text-[10px] md:text-xs leading-loose tracking-[0.2em] uppercase text-[#c5a059] font-bold max-w-xl mx-auto [text-wrap:balance] mb-4">
          Cada invitado realizará un aporte económico para confirmar su asistencia.
        </p>
        <p class="font-sans text-[10px] md:text-xs leading-loose tracking-[0.15em] uppercase opacity-90 max-w-xl mx-auto [text-wrap:balance]">
          Este evento es solo para adultos y la invitación es personal e intransferible y válida únicamente para los invitados a quienes fue enviada.
        </p>
      </div>
    </div>
  </section>

</div>
