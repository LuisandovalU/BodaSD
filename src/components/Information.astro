---
import ScrollEnvelope from './ScrollEnvelope';
---

<div class="flex flex-col w-full">
  
  {/* Sección Importante */}
  <section class="text-white py-36 md:py-48 px-4 text-center relative overflow-hidden">
    {/* Fondo rojo plano y elegante */}
    <div class="absolute inset-0 z-0 bg-brand-wine">
      <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/20 pointer-events-none"></div>
    </div>
    
    <div class="max-w-3xl mx-auto relative z-10">
      <div class="space-y-6">
        <div class="flex justify-center mb-6">
          <img src="/importante_gold.webp" alt="Importante" class="w-[90%] max-w-[320px] md:max-w-[400px] h-auto object-contain drop-shadow-sm" />
        </div>
        <p class="font-sans text-[10px] md:text-xs leading-loose tracking-[0.15em] uppercase opacity-90 max-w-xl mx-auto">
          Este evento es solo para adultos y la invitación es personal e intransferible y válida únicamente para los invitados a quienes fue enviada.
        </p>
      </div>
    </div>
  </section>

  {/* Sección Regalos (Animación al scrollear) */}
  <ScrollEnvelope client:load />

</div>
