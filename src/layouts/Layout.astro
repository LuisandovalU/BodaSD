---
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content="Estás cordialmente invitado a la boda de Sebastián y Daniela. Viernes 11 de Diciembre de 2026 · 3:00 PM · Hacienda San Pablo, Subachoque, Colombia." />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased">
		<slot />

		<!-- ━━━ MÚSICA DE FONDO ━━━ -->
		<!-- Coloca tu canción en public/musica.mp3 para activarla -->
		<audio id="bg-music" loop preload="none">
			<source src="/musica.mp3" type="audio/mpeg" />
		</audio>

		<!-- Botón flotante de música -->
		<button
			id="music-toggle"
			aria-label="Activar/desactivar música"
			title="Música"
		>
			<span id="music-icon-on" style="display:flex;">
				<!-- Nota musical ON -->
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
				</svg>
			</span>
			<span id="music-icon-off" style="display:none;">
				<!-- Nota musical OFF (tachada) -->
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" opacity="0.5">
					<path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
					<line x1="2" y1="2" x2="22" y2="22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
				</svg>
			</span>
			<span id="music-label">Música</span>
		</button>

		<!-- Ondas animadas (solo visibles cuando la música está activa) -->
		<div id="music-waves" style="display:none;">
			<span></span><span></span><span></span>
		</div>

	</body>
</html>

<style>
	#music-toggle {
		position: fixed;
		bottom: 1.5rem;
		left: 1.5rem;
		z-index: 9999;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(74, 13, 24, 0.85);
		border: 1px solid rgba(197, 160, 89, 0.35);
		border-radius: 999px;
		padding: 0.6rem 1rem 0.6rem 0.8rem;
		color: #c5a059;
		font-family: 'Cinzel', serif;
		font-size: 0.5rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		cursor: pointer;
		backdrop-filter: blur(12px);
		box-shadow: 0 4px 20px rgba(0,0,0,0.35);
		transition: all 0.3s ease;
		outline: none;
	}

	#music-toggle:hover {
		background: rgba(74, 13, 24, 0.95);
		border-color: rgba(197, 160, 89, 0.6);
		transform: translateY(-2px);
		box-shadow: 0 8px 28px rgba(0,0,0,0.4);
	}

	#music-label {
		display: none;
	}

	@media (min-width: 480px) {
		#music-label { display: inline; }
	}

	/* Ondas */
	#music-waves {
		position: fixed;
		bottom: 1.85rem;
		left: 3rem;
		z-index: 9998;
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 16px;
		pointer-events: none;
	}

	#music-waves span {
		display: block;
		width: 2px;
		border-radius: 1px;
		background: #c5a059;
		animation: wave-bar 1.2s ease-in-out infinite;
	}

	#music-waves span:nth-child(1) { animation-delay: 0s; }
	#music-waves span:nth-child(2) { animation-delay: 0.2s; }
	#music-waves span:nth-child(3) { animation-delay: 0.4s; }

	@keyframes wave-bar {
		0%, 100% { height: 4px; }
		50% { height: 14px; }
	}
</style>

<script>
	const audio = document.getElementById('bg-music') as HTMLAudioElement;
	const btn = document.getElementById('music-toggle') as HTMLButtonElement;
	const iconOn = document.getElementById('music-icon-on') as HTMLSpanElement;
	const iconOff = document.getElementById('music-icon-off') as HTMLSpanElement;
	const waves = document.getElementById('music-waves') as HTMLDivElement;

	let isPlaying = false;

	function setPlaying(playing: boolean) {
		isPlaying = playing;
		if (playing) {
			audio.play().catch(() => {});
			iconOn.style.display = 'flex';
			iconOff.style.display = 'none';
			waves.style.display = 'flex';
			btn.style.borderColor = 'rgba(197,160,89,0.7)';
		} else {
			audio.pause();
			iconOn.style.display = 'none';
			iconOff.style.display = 'flex';
			waves.style.display = 'none';
			btn.style.borderColor = 'rgba(197,160,89,0.35)';
		}
	}

	btn?.addEventListener('click', () => {
		setPlaying(!isPlaying);
	});

	// Intentar reproducir con el primer toque/clic en la página
	const startOnFirstInteraction = () => {
		if (!isPlaying && audio.src && !audio.src.endsWith('/musica.mp3') === false) {
			// Solo si el archivo existe (no error 404)
			audio.addEventListener('canplay', () => {
				setPlaying(true);
			}, { once: true });
			audio.load();
		}
		document.removeEventListener('click', startOnFirstInteraction);
		document.removeEventListener('touchstart', startOnFirstInteraction);
	};

	document.addEventListener('click', startOnFirstInteraction, { once: true });
	document.addEventListener('touchstart', startOnFirstInteraction, { once: true });
</script>
